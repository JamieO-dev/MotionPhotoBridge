<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!-- Photos resource access, including Developer ID builds using the
         hardened runtime. PhotoKit still requests the user's add-only
         permission at the moment of import. This does not enable App Sandbox. -->
    <key>com.apple.security.personal-information.photos-library</key>
    <true/>
</dict>
</plist>
